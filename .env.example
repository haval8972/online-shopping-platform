# Copy to .env and fill in. Never commit .env.

# --- Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=my_platform
PORT=5000

# --- Security
# Set NODE_ENV=production on the live server: it makes AUTH_SECRET and CORS_ORIGIN
# required and stops the API from ever showing OTP codes.
# NODE_ENV=production
# Long random string that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Sites allowed to call the API from a browser (comma-separated), e.g. https://mybusiness.pk
CORS_ORIGIN=
# Set to 1 only when the API runs behind Nginx or another reverse proxy.
TRUST_PROXY=

# --- First admin accounts (only used when the admin table is empty)
ADMIN_BOOTSTRAP_NAMES=WASSI,HAIDER
ADMIN_BOOTSTRAP_PASSWORD=

# --- SMS for OTP codes
OTP_SMS_PROVIDER=textbelt
TEXTBELT_KEY=textbelt

# --- Frontend
# Browser -> Express API
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Next.js server -> Express API (for the public /products pages)
API_URL=http://localhost:5000/api
# Public address of the site, used in the sitemap and share previews
SITE_URL=http://localhost:3000
